app-id = "dev.fastcloud.Fastcloud"
runtime = org.gnome.Platform
runtime-version = "46"
sdk = org.gnome.Sdk
command = fastcloud
finish-args = [
  "--socket=wayland",
  "--socket=fallback-x11",
  "--socket=pulseaudio",
  "--device=dri",
  "--share=network",
  "--talk-name=org.kde.StatusNotifierItem",
  "--talk-name=org.freedesktop.Notifications",
  "--filesystem=xdg-run/keyring",
]

[build]
build-command = [
  "cargo", "build", "--release", "--offline",
]

[build.build-options]
build-args = [
  "--share=network",
]

[build.sources]
"/" = ".."

[build.modules/fastcloud]
sources = "/" 
